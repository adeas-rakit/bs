
# Konfigurasi Database
JENIS_DB=sqllite

# SQLite database URL (bisa diubah sesuai kebutuhan)
DATABASE_URL="file:./prisma/db/custom.db"

# Secret untuk JSON Web Token (JWT), ganti dengan secret yang kuat
JWT_SECRET="ganti-dengan-secret-super-rahasia-anda"

# App Configuration
NEXT_PUBLIC_APP_NAME="EcoNow"
NEXT_PUBLIC_APP_DESCRIPTION="Aplikasi modern untuk mengelola bank sampah dengan sistem digital yang efisien"
NEXT_PUBLIC_APP_URL="https://econow.com"
NEXT_PUBLIC_OG_IMAGE="/og-image.png"
NEXT_PUBLIC_TWITTER_HANDLE="@econow"

# Demo Mode (set ke "true" untuk menampilkan halaman dan tombol akun demo)
NEXT_PUBLIC_DEMO="true"